rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // SECURITY HELPER FUNCTIONS
    // ==========================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.role == 'admin' || request.auth.token.admin == true);
    }

    function isConversationParticipant(convData) {
      return isAuthenticated() && (request.auth.uid in convData.participantIds);
    }

    // ==========================================
    // USERNAMES REGISTRY (Guarantees Uniqueness)
    // ==========================================
    match /usernames/{username} {
      allow read: if true;
      allow create: if isAuthenticated() 
                    && request.resource.data.uid == request.auth.uid
                    && username.matches('^[a-z0-9_.-]{3,30}$');
      allow delete: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // ==========================================
    // USERS COLLECTION
    // ==========================================
    match /users/{userId} {
      allow read: if true; // Public profiles
      allow create: if isOwner(userId) 
                    && request.resource.data.uid == userId
                    && request.resource.data.username is string;
      allow update: if (isOwner(userId) && request.resource.data.uid == userId) || isAdmin();
      allow delete: if isAdmin();

      // Followers Subcollection
      match /followers/{followerId} {
        allow read: if true;
        // User cannot follow themselves
        allow create: if isOwner(followerId) && followerId != userId;
        allow delete: if isOwner(followerId) || isOwner(userId) || isAdmin();
      }

      // Following Subcollection
      match /following/{followingId} {
        allow read: if true;
        allow create: if isOwner(userId) && userId != followingId;
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    // ==========================================
    // POSTS COLLECTION
    // ==========================================
    match /posts/{postId} {
      // Visibility-based read rules
      allow read: if resource.data.visibility == 'public' 
                  || (isAuthenticated() && resource.data.authorId == request.auth.uid)
                  || (isAuthenticated() && resource.data.visibility == 'followers' && exists(/databases/$(database)/documents/users/$(resource.data.authorId)/followers/$(request.auth.uid)))
                  || isAdmin();

      allow create: if isAuthenticated() 
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.visibility in ['public', 'followers', 'private']
                    && request.resource.data.mediaType in ['text', 'image', 'video'];

      allow update: if (isAuthenticated() && resource.data.authorId == request.auth.uid)
                    // Allow atomic increments for likes, comments, shares, saves
                    || (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'commentCount', 'shareCount', 'saveCount']))
                    || isAdmin();

      allow delete: if (isAuthenticated() && resource.data.authorId == request.auth.uid) || isAdmin();

      // Likes Subcollection (Prevent duplicate likes)
      match /likes/{userId} {
        allow read: if true;
        allow create: if isOwner(userId);
        allow delete: if isOwner(userId) || isAdmin();
      }

      // Comments Subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() 
                      && (request.resource.data.userId == request.auth.uid || request.resource.data.authorId == request.auth.uid)
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0;
        allow update: if isAuthenticated() && (
          resource.data.userId == request.auth.uid || 
          resource.data.authorId == request.auth.uid ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount']) ||
          isAdmin()
        );
        allow delete: if isAuthenticated() && (
          resource.data.userId == request.auth.uid || 
          resource.data.authorId == request.auth.uid || 
          isAdmin()
        );
      }

      // Saves Subcollection (Private to each user)
      match /saves/{userId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow delete: if isOwner(userId);
      }
    }

    // ==========================================
    // CONVERSATIONS & PRIVATE MESSAGING
    // ==========================================
    match /conversations/{conversationId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participantIds;
      allow create: if isAuthenticated() 
                    && request.auth.uid in request.resource.data.participantIds
                    && request.resource.data.participantIds.size() == 2;
      allow update: if isAuthenticated() && (
        request.auth.uid in resource.data.participantIds
      );

      // Messages Subcollection
      match /messages/{messageId} {
        allow read: if isAuthenticated() && 
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow create: if isAuthenticated() 
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow update: if isAuthenticated() && (
          // Mark seen
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen', 'seenAt'])
        );
      }
    }

    // ==========================================
    // NOTIFICATIONS
    // ==========================================
    match /notifications/{notificationId} {
      // Recipient can read and update (mark as read)
      allow read: if isAuthenticated() && resource.data.recipientId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.recipientId == request.auth.uid;
      // Authenticated users or Cloud Functions can create notification
      allow create: if isAuthenticated() && request.resource.data.recipientId != request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.recipientId == request.auth.uid;
    }

    // ==========================================
    // REPORTS (User safety & content moderation)
    // ==========================================
    match /reports/{reportId} {
      allow create: if isAuthenticated() && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    // ==========================================
    // WEBRTC CALL SIGNALING & HISTORY
    // ==========================================
    match /calls/{callId} {
      allow create: if isAuthenticated() && request.resource.data.caller.uid == request.auth.uid;
      allow read, update, delete: if isAuthenticated() && (
        resource.data.caller.uid == request.auth.uid || 
        resource.data.receiver.uid == request.auth.uid ||
        isAdmin()
      );

      match /callerCandidates/{candId} {
        allow read, write: if isAuthenticated() && (
          get(/databases/$(database)/documents/calls/$(callId)).data.caller.uid == request.auth.uid ||
          get(/databases/$(database)/documents/calls/$(callId)).data.receiver.uid == request.auth.uid
        );
      }

      match /receiverCandidates/{candId} {
        allow read, write: if isAuthenticated() && (
          get(/databases/$(database)/documents/calls/$(callId)).data.caller.uid == request.auth.uid ||
          get(/databases/$(database)/documents/calls/$(callId)).data.receiver.uid == request.auth.uid
        );
      }
    }

    match /call_history/{historyId} {
      allow create, read, delete: if isAuthenticated() && (
        request.resource.data.callerUid == request.auth.uid ||
        request.resource.data.receiverUid == request.auth.uid ||
        resource.data.callerUid == request.auth.uid ||
        resource.data.receiverUid == request.auth.uid
      );
    }
  }
}
